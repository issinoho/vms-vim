$! MAKE_KIT.COM - build the PCSI kit for this node's architecture
$!
$! Usage:  @[.VMS.KIT]MAKE_KIT
$! Needs a built tree (@[.VMS]BUILD): VIM.EXE in [.SRC.<arch>], XXD.EXE in
$! [.SRC.XXD.<arch>], and the runtime in [.RUNTIME] (tools/push.sh <node>
$! runtime).  Writes the kit to [.KIT_<arch>].  The product description, text
$! module, VIM$CASE.VIM, KIT_MATERIAL.VIM and the documents were generated by
$! tools/prepare.sh into [.VMS.KIT].
$!
$ set noon
$ status = 44
$ saved_default = f$environment("DEFAULT")
$ saved_parse = f$getjpi("", "PARSE_STYLE_PERM")
$ set process/parse_style=extended
$ proc = f$environment("PROCEDURE")
$ kitdir = f$parse(proc,,,"DEVICE") + f$parse(proc,,,"DIRECTORY")
$ set default 'kitdir'
$ set default [--]
$ arch = f$edit(f$getsyi("ARCH_NAME"), "UPCASE")
$ base = "I64VMS"
$ if arch .eqs. "X86_64" then base = "X86VMS"
$!
$! KIT_PRODUCER, PCSI_VERSION, KIT_VERSION from kit.env
$ open/read env [.VMS.KIT]KIT.ENV
$env_loop:
$ read/end=env_done env line
$ name = f$element(0, "=", line)
$ 'name' = f$element(1, "=", line)
$ goto env_loop
$env_done:
$ close env
$!
$ need = "[.SRC.''arch']VIM.EXE,[.SRC.XXD.''arch']XXD.EXE,[.RUNTIME]DEFAULTS.VIM,[.VMS.KIT]KIT_MATERIAL.VIM"
$ i = 0
$need_loop:
$ f = f$element(i, ",", need)
$ if f .eqs. "," then goto need_done
$ if f$search(f) .eqs. ""
$ then
$   write sys$error "MAKE_KIT: no ''f'; build (and push the runtime) first"
$   goto done
$ endif
$ i = i + 1
$ goto need_loop
$need_done:
$!
$! Gather the files flat in [.KIT_<arch>.MAT]: PRODUCT PACKAGE looks each
$! one up by name in the material directory (destinations are in the PDF).
$ mat = "[.KIT_''arch'.MAT]"
$ out = "[.KIT_''arch']"
$ if f$search("KIT_''arch'.DIR") .eqs. "" then create/directory 'out'
$ if f$search("[.KIT_''arch']MAT.DIR") .eqs. "" then create/directory 'mat'
$ if f$search("''out'*.PCSI;*") .nes. "" then delete/nolog 'out'*.PCSI;*
$ if f$search("''mat'*.*;*") .nes. "" then delete/nolog 'mat'*.*;*
$ copy/nolog [.SRC.'arch']VIM.EXE,[.SRC.XXD.'arch']XXD.EXE 'mat'
$ copy/nolog [.VMS.KIT]VIM$STARTUP.COM,VIM$SETUP.COM,VIMTUTOR.COM,VIM$CASE.VIM,README.VMS 'mat'
$ copy/nolog [.VMS.KIT.DOC]*.* 'mat'
$ matspec = f$parse(mat,,,"DEVICE","NO_CONCEAL") + f$parse(mat,,,"DIRECTORY","NO_CONCEAL")
$!
$! The runtime: one Vim run copies each file to its material name
$! (KIT_MATERIAL.VIM, from tools/prepare.sh); thousands of COPY commands
$! would take far longer.
$ rt = f$parse("[.RUNTIME]",,,"DEVICE") + f$parse("[.RUNTIME]",,,"DIRECTORY")
$ define/nolog vimkit_rt 'rt'
$ define/nolog vimkit_mat 'matspec'
$ vimexe = "$" + f$parse("[.SRC.''arch']VIM.EXE")
$ write sys$output "MAKE_KIT: copying the runtime to ''matspec'"
$ define/user sys$input nl:
$ vimexe -es -u NONE -i NONE -n "+source [.VMS.KIT]KIT_MATERIAL.VIM"
$ deassign vimkit_rt
$ deassign vimkit_mat
$ if f$search("[.VMS.KIT]KIT_MATERIAL.OK") .eqs. ""
$ then
$   write sys$error "MAKE_KIT: copying the runtime failed:"
$   if f$search("[.VMS.KIT]KIT_MATERIAL.ERR") .nes. "" then type [.VMS.KIT]KIT_MATERIAL.ERR
$   goto done
$ endif
$ type [.VMS.KIT]KIT_MATERIAL.OK
$ delete/nolog [.VMS.KIT]KIT_MATERIAL.OK;*
$!
$ write sys$output "MAKE_KIT: ''KIT_PRODUCER' ''base' VIM ''PCSI_VERSION' (Vim ''KIT_VERSION')"
$ product package VIM -
    /producer='KIT_PRODUCER' /base_system='base' /version='PCSI_VERSION' -
    /source=[.VMS.KIT]VIM-'base'.PCSI$DESC -
    /material='matspec' -
    /destination='out' -
    /format=sequential -
    /options=noconfirm
$ status = $status
$ kit = f$search("''out'*.PCSI")
$ if kit .nes. "" then write sys$output "MAKE_KIT: kit ", kit
$ if kit .eqs. "" then status = 44
$done:
$ set process/parse_style='saved_parse'
$ set default 'saved_default'
$ exit status
